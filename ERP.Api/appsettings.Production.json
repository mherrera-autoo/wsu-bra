{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "<PLACEHOLDER_ALLOWED_ORIGIN>"
  ],
  "CookieSecure": true,
  "SameSite": "Lax",
  "ConnectionStrings": {
    "ErpDatabase": "<PLACEHOLDER_CONNECTION_STRING>"
  },
  "Jwt": {
    "Issuer": "<PLACEHOLDER_JWT_ISSUER>",
    "Audience": "<PLACEHOLDER_JWT_AUDIENCE>",
    "SigningKey": "<PLACEHOLDER_JWT_SIGNING_KEY>",
    "RefreshTokenDays": 30
  },
  "Bootstrap": {
    "AdminEmail": "<PLACEHOLDER_ADMIN_EMAIL>",
    "AdminPassword": "<PLACEHOLDER_ADMIN_PASSWORD>",
    "BootstrapToken": "<PLACEHOLDER_BOOTSTRAP_TOKEN>",
    "Organization": {
      "Name": "<PLACEHOLDER_ORGANIZATION_NAME>",
      "DisplayName": "<PLACEHOLDER_ORGANIZATION_DISPLAY_NAME>",
      "AccountType": "MultiCompany"
    },
    "Company": [
      {
        "Name": "<PLACEHOLDER_COMPANY_NAME_1>",
        "TaxId": "<PLACEHOLDER_TAX_ID_1>",
        "OrganizationName": "<PLACEHOLDER_COMPANY_ORG_NAME_1>"
      },
      {
        "Name": "<PLACEHOLDER_COMPANY_NAME_2>",
        "TaxId": "<PLACEHOLDER_TAX_ID_2>",
        "OrganizationName": "<PLACEHOLDER_COMPANY_ORG_NAME_2>"
      }
    ]
  },
  "RfidBootstrap": {
    "AdminEmail": "<PLACEHOLDER_RFID_ADMIN_EMAIL>",
    "AdminPassword": "<PLACEHOLDER_RFID_ADMIN_PASSWORD>",
    "BootstrapToken": "<PLACEHOLDER_RFID_BOOTSTRAP_TOKEN>",
    "Organization": {
      "Name": "<PLACEHOLDER_RFID_ORGANIZATION_NAME>",
      "DisplayName": "<PLACEHOLDER_RFID_ORGANIZATION_DISPLAY_NAME>",
      "AccountType": "MultiCompany"
    },
    "Company": [
      {
        "Name": "<PLACEHOLDER_RFID_COMPANY_NAME>",
        "TaxId": "<PLACEHOLDER_RFID_TAX_ID>",
        "OrganizationName": "<PLACEHOLDER_RFID_ORG_NAME>"
      }
    ]
  },
  "Wsu": {
    "MasterCompanyName": "<PLACEHOLDER_MASTER_COMPANY_NAME>"
  },
  "DevSeed": {
    "Key": "<PLACEHOLDER_DEV_SEED_KEY>"
  },
  "PasswordReset": {
    "TokenExpiryMinutes": 15,
    "FrontendResetUrl": "<PLACEHOLDER_FRONTEND_RESET_URL>"
  },
  "PasswordReusePolicy": {
    "DisallowLastN": 5
  }
}
